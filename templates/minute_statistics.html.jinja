<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detection Statistics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@2.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <style>
        body {
            padding: 20px;
            background-color: #212529;
            color: #f8f9fa;
        }
        .stats-card {
            margin-bottom: 20px;
            background-color: #2c3034;
            border-color: #373b3f;
        }
        .card-header {
            background-color: #373b3f;
            color: #f8f9fa;
            font-weight: bold;
        }
        .card-body {
            color: #f8f9fa;
        }
        #refreshButton {
            margin-bottom: 20px;
        }
        .chart-container {
            height: 300px;
            background-color: #2c3034;
            border-radius: 0.375rem;
            padding: 15px;
        }
        h1, h2 {
            color: #f8f9fa;
        }
        .input-group-text {
            background-color: #373b3f;
            color: #f8f9fa;
            border-color: #495057;
        }
        .form-control {
            background-color: #2c3034;
            color: #f8f9fa;
            border-color: #495057;
        }
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="mb-4">
            <h1>Detection Statistics</h1>
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">Minutes</span>
                        <input type="number" class="form-control" id="minutesInput" value="1" min="1" max="60">
                        <button class="btn btn-primary" id="refreshButton">Refresh</button>
                    </div>
                </div>
            </div>
        </header>

        <div class="row">
            <div class="col-md-3">
                <div class="card stats-card">
                    <div class="card-header">Total People</div>
                    <div class="card-body">
                        <h2 id="totalPeople">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card">
                    <div class="card-header">Total Detections</div>
                    <div class="card-body">
                        <h2 id="totalDetections">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card">
                    <div class="card-header">First Seen</div>
                    <div class="card-body">
                        <p id="firstSeen">-</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card">
                    <div class="card-header">Last Seen</div>
                    <div class="card-body">
                        <p id="lastSeen">-</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="chart-container">
                    <canvas id="historyChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Initialize chart
        const ctx = document.getElementById('historyChart').getContext('2d');
        const historyChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [
                    {
                        label: 'People Count',
                        data: [],
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.1
                    },
                    {
                        label: 'Detections',
                        data: [],
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: 'minute',
                            displayFormats: {
                                minute: 'HH:mm:ss'
                            }
                        },
                        grid: {
                            color: 'rgba(255, 255, 255, 0.1)'
                        },
                        ticks: {
                            color: '#f8f9fa'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.1)'
                        },
                        ticks: {
                            color: '#f8f9fa'
                        }
                    }
                },
                plugins: {
                    legend: {
                        labels: {
                            color: '#f8f9fa'
                        }
                    }
                }
            }
        });

        // Keep history data
        const historyData = {
            timestamps: [],
            people: [],
            detections: []
        };

        // Maximum history points
        const MAX_HISTORY = 30;

        // Update the UI with statistics
        function updateStatistics(data) {
            // Update card values
            document.getElementById('totalPeople').textContent = data.total_people;
            document.getElementById('totalDetections').textContent = data.total_detections;
            
            // Format timestamps nicely if they exist
            if (data.first_seen) {
                const firstSeen = new Date(data.first_seen);
                document.getElementById('firstSeen').textContent = firstSeen.toLocaleTimeString();
            } else {
                document.getElementById('firstSeen').textContent = '-';
            }
            
            if (data.last_seen) {
                const lastSeen = new Date(data.last_seen);
                document.getElementById('lastSeen').textContent = lastSeen.toLocaleTimeString();
            } else {
                document.getElementById('lastSeen').textContent = '-';
            }

            // Add to history
            const timestamp = new Date(data.timestamp * 1000);
            historyData.timestamps.push(timestamp);
            historyData.people.push(data.total_people);
            historyData.detections.push(data.total_detections);

            // Limit history size
            if (historyData.timestamps.length > MAX_HISTORY) {
                historyData.timestamps.shift();
                historyData.people.shift();
                historyData.detections.shift();
            }

            // Update chart data
            historyChart.data.datasets[0].data = historyData.timestamps.map((time, i) => ({
                x: time,
                y: historyData.people[i]
            }));
            
            historyChart.data.datasets[1].data = historyData.timestamps.map((time, i) => ({
                x: time,
                y: historyData.detections[i]
            }));
            
            historyChart.update();
        }

        // Fetch statistics from API
        async function fetchStatistics() {
            const minutes = document.getElementById('minutesInput').value;
            try {
                const response = await fetch(`/api/stats?minutes=${minutes}`);
                if (!response.ok) {
                    console.error('Error response from server:', response.status);
                    return;
                }
                
                const data = await response.json();
                console.log('Received data:', data);
                updateStatistics(data);
            } catch (error) {
                console.error('Error fetching statistics:', error);
            }
        }

        // Setup refresh button
        document.getElementById('refreshButton').addEventListener('click', fetchStatistics);

        // Initial fetch
        fetchStatistics();

        // Set up auto-refresh every 10 seconds
        setInterval(fetchStatistics, 10000);
    </script>
</body>
</html> 