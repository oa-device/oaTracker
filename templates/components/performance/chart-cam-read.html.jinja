<div class="chart-container">
    <canvas id="chartCamRead" class="chart-canvas"></canvas>
    <script>

        const dataCamRead = {
            datasets: [
                {
                    label: "Device 0",
                    data: [],
                    fill: false,
                    tension: 0.1,
                },

                {
                    label: "Device 1",
                    data: [],
                    fill: false,
                    tension: 0.1,
                }
            ],
        };

        const ctxCamRead = document.getElementById('chartCamRead');

        const chartCamRead = new Chart(ctxCamRead, {
            type: 'line',
            data: dataCamRead,
            options: {
            events: [],
                legend: {
                    position: 'top',
                    labels: {
                        fontColor: 'white'
                    }
                },
                scales: {
                    x: {
                        type: 'timeseries',
                    },
                    y: {
                        ticks: {
                            // Include a dollar sign in the ticks
                            callback: function (value, index, ticks) {
                                return value + 'ms';
                            }
                        }
                    }
                }
                , plugins: {
                    title: {
                        display: true,
                        text: 'Cam read'
                    }
                }
            }
        });

        const chartCamReadUpdate = () => {
            chartCamRead.update("none");
        }

        window.sseSubscriptions["cam_read_perf_0"] = window.sseSubscriptions["cam_read_perf_0"] || []
        window.sseSubscriptions["cam_read_perf_0"].push((m) => {
            const limit = (Date.now()) - 10000;
            chartCamRead.data.datasets[0].data.push([m.ts, m.value])
            chartCamRead.data.datasets[0].data = chartCamRead.data.datasets[0].data.filter(x => x[0] > limit)
            chartCamReadUpdate()
        })
        window.sseSubscriptions["cam_read_perf_1"] = window.sseSubscriptions["cam_read_perf_1"] || []
        window.sseSubscriptions["cam_read_perf_1"].push((m) => {
            const limit = (Date.now()) - 10000;
            chartCamRead.data.datasets[1].data.push([m.ts, m.value])
            chartCamRead.data.datasets[1].data = chartCamRead.data.datasets[1].data.filter(x => x[0] > limit)
            chartCamReadUpdate()
        })

    </script>
</div>