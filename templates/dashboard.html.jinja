<!DOCTYPE html>
<html>

<head>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="/static/chartjs-date-adapter.js"></script>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
		integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
<script src="https://d3js.org/d3.v3.min.js" charset="utf-8"></script>
  <link rel='stylesheet' href='https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css' />
    <script src='https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js'></script>
  
</head>
<style>
	.accordion-button:not(.collapsed) {
		background-color: transparent;
	}


	.chart-canvas {
		width: 100% !important;
		height: 100% !important;
		display: block;
	}

	.card-img-top {
		aspect-ratio: 1.77777777778;
	}

	.chart-container {
		padding: 1px;
	}

	thead {
		font-size: 0.7rem;
	}

	.count_result_col {
		text-align: center;
	}

	.count_result {

		font-size: 5rem;
		margin: 2rem 0;
	}

	.progress {
		width: 120px;
		height: 120px;
		background: none;
		position: relative;
	}

	.progress::after {
		content: "";
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: 6px solid #eee;
		position: absolute;
		top: 0;
		left: 0;
	}

	.progress>span {
		width: 50%;
		height: 100%;
		overflow: hidden;
		position: absolute;
		top: 0;
		z-index: 1;
	}

	.progress .progress-left {
		left: 0;
	}

	.progress .progress-bar {
		width: 100%;
		height: 100%;
		background: none;
		border-width: 6px;
		border-style: solid;
		position: absolute;
		top: 0;
	}

	.progress .progress-left .progress-bar {
		left: 100%;
		border-top-right-radius: 80px;
		border-bottom-right-radius: 80px;
		border-left: 0;
		-webkit-transform-origin: center left;
		transform-origin: center left;
	}

	.progress .progress-right {
		right: 0;
	}

	.progress .progress-right .progress-bar {
		left: -100%;
		border-top-left-radius: 80px;
		border-bottom-left-radius: 80px;
		border-right: 0;
		-webkit-transform-origin: center right;
		transform-origin: center right;
	}

	.progress .progress-value {
		position: absolute;
		top: 0;
		left: 0;
	}
</style>
<script>
	Chart.defaults.font.color = 'white'
	Chart.defaults.borderColor = 'rgb(135, 138, 140)';
	Chart.defaults.color = 'rgb(222, 226, 230)';
	let reload = !document.hidden;
	document.addEventListener("visibilitychange", () => {
		if (document.hidden) {
			reload = false
		} else {
			reload = true
		}
	});

	function throttle(cb, delay = 250) {
		let shouldWait = false

		return (...args) => {
			if (shouldWait) return

			cb(...args)
			shouldWait = true
			setTimeout(() => {
				shouldWait = false
			}, delay)
		}
	}

	const throttledError = throttle((e) => {
		console.error(e)
	}, 1000)


	const onlineUrl = window.location.href.replace('dashboard', 'online');

	let sse;
	function setupSSE(_start, _end) {
		const start = _start || 'entrance';
		const end = _end || 'exit';

		if (typeof sse !== 'undefined') {
			sse.close();
		}

		sse = new EventSource(`//${window.location.hostname}:8080/dashboard/sse?start=${start}&end=${end}`);

		if (!window.sseSubscriptions) {
			window.sseSubscriptions = {}
		}

		const gotFirstMessage = false;
		sse.onmessage = (event) => {
			resetReloadTimeout();
			const message = JSON.parse(event.data)
			console.log(message)

			window.onData(message)
		};
	}

	setupSSE();

	let interval1
	let interval2
	function resetReloadTimeout() {
		clearInterval(interval1)
		interval1 = setInterval(() => fetch(onlineUrl).catch(() => {
			clearInterval(interval1)
			clearInterval(interval2)
			interval2 = setInterval(() => fetch(onlineUrl).then(() => { window.location.reload(); 
			clearInterval(interval2); }), 500)
		}), 1500)
	}
</script>
</head>

<body data-bs-theme="dark" style="overflow-x: hidden;">
	<div class="row">
		<div class="col">
			<div id="cam" style="
    position: fixed;
    left: 25%;
    top:50%;
