	window.formatDuration = function formatDuration(milliseconds) {
		var time = { a: 31536000000, j: 86400000, h: 3600000, m: 60000, s: 1000, ms: 1 },
			res = [];

		if (milliseconds === 0) return 'now';


		for (var key in time) {
			if (milliseconds >= time[key]) {
				var val = Math.floor(milliseconds / time[key]);
				res.push(val += val > 1 ? ' ' + key + '' : ' ' + key);
				milliseconds = milliseconds % time[key];
			}
		}

		cam_img.addEventListener("click", (event) => {

		});

		return res.length > 1 ? res.join(', ').replace(/,([^,]*)$/, ',' + '$1') : res[0]
	}

