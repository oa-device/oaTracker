<script>

	function throttle(cb, delay = 250) {
		let shouldWait = false

		return (...args) => {
			if (shouldWait) return

			cb(...args)
			shouldWait = true
			setTimeout(() => {
				shouldWait = false
			}, delay)
		}
	}

	const throttledError = throttle((e) => {
		console.error(e)
	}, 1000)


	const onlineUrl = window.location.href.replace('dashboard', 'online');
	const fifteenSecondsInMs = 15 * 1000;
	const fiveSecondsInMs = 5 * 1000;
	const fiveMinutesInMs = 5 * 60 * 1000;
	window.processBuckets = function processBuckets(data) {
		const latestTimestamp = data[data.length - 1][0];

		const buckets = new Map();

		data.forEach((item) => {
			const timestamp = item[0]
			const value = item[1]
			const isLatest = timestamp >= latestTimestamp - fiveMinutesInMs;

			if (isLatest) {
				const bucketKey = Math.floor(timestamp / fiveSecondsInMs);
				buckets.set('l'+bucketKey, [timestamp, value]); // Overwrite to keep the last value in the bucket
			}
			else {
				const bucketKey = Math.floor(timestamp / fifteenSecondsInMs);
				buckets.set(bucketKey, [timestamp, value]); // Overwrite to keep the last value in the bucket
			}
		});


		// Combine earlier buckets and latest data
		const result = Array.from(buckets.values());
		
		// Sort the result by timestamp
		result.sort((a, b) => a[0] - b[0]);
		
		return result;
	}


	window.chartTooltip = {

		tooltip: {

			enabled: true, // Enable tooltips
			mode: 'x',
			intersect: false,

			callbacks: {
				// Customize tooltip labels
				title: (tooltipItems) => {
					return `Date: ${tooltipItems[0].label}`;
				},
				label: (tooltipItem) => {
					return `Value: ${tooltipItem.raw}`;
				},
			},
		}
	}
	setInterval(() => { clock.innerText = new Date().toTimeString().split(' ')[0] }, 50);

	let sse;
	function setupSSE(_start, _end) {
		const start = _start || 'entrance';
		const end = _end || 'exit';

		if (typeof sse !== 'undefined') {
			sse.close();
		}

		sse = new EventSource(`//${window.location.hostname}:8080/dashboard/sse?start=${start}&end=${end}`);

		if (!window.sseSubscriptions) {
			window.sseSubscriptions = {}
		}

		const gotFirstMessage = false;
		sse.onmessage = (event) => {
			//resetReloadTimeout();
			const message = JSON.parse(event.data)
			window.dispatchEvent(new CustomEvent("sse", { detail: message }))
			enter_building_door_left_value.innerText = message[2].last_seen_zone_out_door_left
			enter_building_door_right_value.innerText = message[2].last_seen_zone_out_door_right
			last_15_seconds_presence.innerText = message[6]
		};
	}

	setupSSE();

